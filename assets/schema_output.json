{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/arboratornf/main/assets/schema_output.json",
    "title": "ArboratorNF Output Schema",
    "description": "The ArboratorNF-specific schema used for validating IRIDA Next JSON output data",
    "type": "object",
    "properties": {
        "files": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "array",
                    "items": {
                        "properties": {
                            "path": {
                                "anyOf": [
                                    {
                                        "pattern": "^.*pipeline_info/.*software_versions.yml$",
                                        "description": "Software versions used by the pipeline."
                                    },
                                    {
                                        "pattern": "^.*arborview/.*arborview.html$",
                                        "description": "A viewable results file rendered by ArborView."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*cluster_summary.xlsx$",
                                        "description": "An XLSX-formatted file containing cluster summary information for the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*cluster_summary.tsv$",
                                        "description": "An TSV-formatted file containing cluster summary information for the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_profile.tsv$",
                                        "description": "A summary of allele profiles of each sample in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_outliers.tsv$",
                                        "description": "A summary of outliers in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*metadata.linelist.xlsx$",
                                        "description": "An XLSX-formatted line list summarizing the metadata associated with each sample in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*metadata.included.tsv$",
                                        "description": "A summary of the metadata for each sample analyzed in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*metadata.excluded.tsv$",
                                        "description": "A summary of the metadata for each sample not analyzed in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_matrix.tsv$",
                                        "description": "The distance matrix of samples in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_loci.summary.tsv$",
                                        "description": "Summary information for each locus in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_clusters.tsv$",
                                        "description": "A summary of the clusters in the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_metadata.tsv$",
                                        "description": "A summary of the metadata within the partition."
                                    },
                                    {
                                        "pattern": "^.*arborator/.*_tree.nwk$",
                                        "description": "A Newick-formatted phylogenetic tree generated from the samples in the partition."
                                    },
                                    {
                                        "pattern": "^.*zip/.*arboratornf.zip$",
                                        "description": "A ZIP-compressed directory containing the output files generated by the workflow."
                                    }
                                ]
                            }
                        },
                        "additionalProperties": false
                    },
                    "uniqueItems": true
                },
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "properties": {
                                    "path": {
                                        "anyOf": [
                                            {
                                                "pattern": "^.*staramr/.*_results/.*_settings.staramr.txt$",
                                                "description": "The StarAMR-specific command-line parameters, settings, and databases used for the sample."
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "object",
                            "properties": {
                                "StarAMR Quality Module": {
                                    "description": "Whether or not the sample passed of failed the quality evaluation."
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            }
        }
    }
}
